  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && npm run build -- --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "html-to-docx": "1.8.0",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "marked": "18.0.14",
    "pdfjs-dist": "4.10.38",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
